# SpriteMind runtime configuration.
# These are plain environment variables (no .env loader is bundled): export them
# in your shell, or set them in the launcher/Docker/systemd unit.

# HTTP server
HOST=127.0.0.1
PORT=7860

# Torch CPU threads used for neural sprite decoding (1 is fastest on most CPUs).
SPRITEMIND_THREADS=2

# Comma-separated browser origins allowed to call the API. The bundled web
# studio is served from the same origin, so this only matters for `npm run dev`.
SPRITEMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7860,http://127.0.0.1:7860
