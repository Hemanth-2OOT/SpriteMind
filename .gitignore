# =====================================================================
# SpriteMind Git Ignore Configuration
# =====================================================================

# Bytecode and Python runtime caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Environments & Packaging
.env
.venv
venv/
ENV/
env/
build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node & Frontend dependencies (preserve built dist for out-of-the-box local serving)
node_modules/
!frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Local temporary files, caches, and trash
*.tmp
*.log
vite_test.json
data/temp/
data/trash/
data/cache/
data/backups/
*.db-journal
*.db-wal

# Large datasets that should be tracked via Git LFS or reproduced via scripts:
# (Note: Use 'git lfs track "*.jsonl"' or generate with 'python -m spritemind.dataset.storage')
data/datasets/generalization_10k/records.jsonl
